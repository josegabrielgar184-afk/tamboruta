{
  "expo": {
    "name": "TamboRuta",
    "slug": "tamboruta",
    "version": "1.0.0",
    "newArchEnabled": false,
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tamboruta",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chofera.tambogrande",
      "infoPlist": {
        "NSCameraUsageDescription": "Necesitamos acceso a la cámara para fotos en el chat.",
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso al carrete para subir comprobantes.",
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación para el mapa del viaje.",
        "NSMicrophoneUsageDescription": "Necesitamos acceso al micrófono para notas de voz."
      }
    },
    "android": {
      "package": "com.chofera.tambogrande",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#059669"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCM0CDSIT0moeZbSxK6fo06VZ7s_YAzZbQ"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResources": false
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Acceso a la cámara para enviar fotos en el chat."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Acceso a tu ubicación para el mapa del viaje."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Acceso a la galería para enviar fotos.",
          "cameraPermission": "Acceso a la cámara para enviar fotos."
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "babbc2dc-103a-4cf1-86bf-067bd75c6c3f"
      }
    }
  }
}